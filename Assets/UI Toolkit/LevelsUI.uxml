<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="Root" style="flex-grow: 1; justify-content: center; align-items: center; background-image: url(&quot;project://database/Assets/Sprites/Menu/Fondo.png?fileID=2800000&amp;guid=30fd39c99b213fb47a8e46214ca6392c&amp;type=3#Fondo&quot;); -unity-background-scale-mode: stretch-to-fill; padding-top: 32px;">
        <ui:VisualElement name="TitleBlock" style="align-items: center; margin-bottom: 24px;">
            <ui:Label name="Title" text="Select Levels" style="color: rgb(232, 234, 246); font-size: 56px; font-weight: bold; letter-spacing: 4px; -unity-font-definition: url(&quot;project://database/Assets/Font/Perpetua-Titling-Regular.otf?fileID=12800000&amp;guid=7fb653e74e5a2c045ac0260f9d6c7cf3&amp;type=3#Perpetua-Titling-Regular&quot;); -unity-text-align: middle-center;"/>
            <ui:VisualElement name="Divider" style="flex-direction: row; align-items: center; width: 500px; height: 20px; margin-top: 4px;">
                <ui:VisualElement name="LineLeft" style="flex-grow: 1; height: 1px; background-color: rgba(220, 225, 255, 0.35);"/>
                <ui:Label name="Ornament" text=" ❧ " style="color: rgba(255, 255, 255, 0.8); font-size: 30px; -unity-text-align: middle-center;"/>
                <ui:VisualElement name="LineRight" style="flex-grow: 1; height: 1px; background-color: rgba(220, 225, 255, 0.35);"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="SlotList" style="width: 880px; align-items: stretch;">
            <ui:VisualElement name="SlotRow1" style="flex-direction: row; align-items: center; margin-bottom: 0;">
