                        <ui:Label name="GeoCount" text="52" style="color: rgb(184, 188, 238); font-size: 14px;"/>
                        <ui:Label name="PlayTime" text="55m" style="color: rgb(136, 144, 184); font-size: 13px; flex-grow: 1; -unity-text-align: middle-right;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="StatusLevel1" style="align-items: center; gap: 4px; margin-left: 16px; width: 90px;">
