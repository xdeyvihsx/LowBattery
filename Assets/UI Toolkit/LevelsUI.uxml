                <ui:Label name="Num1" text="1." style="color: rgb(210, 215, 248); font-size: 28px; font-weight: bold; width: 42px; -unity-font-definition: url(&quot;project://database/Assets/Font/Perpetua-Titling-Regular.otf?fileID=12800000&amp;guid=7fb653e74e5a2c045ac0260f9d6c7cf3&amp;type=3#Perpetua-Titling-Regular&quot;);"/>
                <ui:VisualElement name="LevelCard1" style="flex-grow: 1; min-height: 76px; background-color: rgb(26, 32, 96); border-radius: 4px; padding: 8px 14px; border-bottom-width: 1px; border-bottom-color: rgba(200, 210, 255, 0.2); justify-content: space-between;">
                    <ui:VisualElement name="LevelTop" style="flex-direction: row; align-items: center; gap: 10px;">
                        <ui:VisualElement name="KnightIcon" style="width: 48px; height: 48px; border-radius: 24px; background-color: rgb(24, 32, 58); border-width: 1.5px; border-color: rgba(200, 210, 255, 0.3); align-items: center; justify-content: center;">
                            <ui:VisualElement name="KnightFace" style="width: 30px; height: 30px; border-radius: 15px; background-color: rgb(216, 221, 245);"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="HPRow" style="flex-direction: row; gap: 4px; align-items: center;">
                            <ui:VisualElement style="width: 14px; height: 14px; border-radius: 7px; background-color: rgb(200, 204, 232);"/>
                            <ui:VisualElement style="width: 14px; height: 14px; border-radius: 7px; background-color: rgb(200, 204, 232);"/>
                            <ui:VisualElement style="width: 14px; height: 14px; border-radius: 7px; background-color: rgb(200, 204, 232);"/>
