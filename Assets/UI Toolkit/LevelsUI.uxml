                            <ui:VisualElement style="width: 14px; height: 14px; border-radius: 7px; background-color: rgb(200, 204, 232);"/>
                            <ui:VisualElement style="width: 14px; height: 14px; border-radius: 7px; background-color: rgba(200, 204, 232, 0.35);"/>
                            <ui:VisualElement style="width: 11px; height: 11px; border-radius: 6px; background-color: rgb(112, 176, 255); margin-left: 4px;"/>
                        </ui:VisualElement>
                        <ui:Label name="Location" text="THE HOUSE 2a.m" style="color: rgb(255, 255, 255); font-size: 16px; font-weight: bold; letter-spacing: 2px; flex-grow: 1; -unity-text-align: middle-right; -unity-font-definition: url(&quot;project://database/Assets/Font/Perpetua-Titling-Regular.otf?fileID=12800000&amp;guid=7fb653e74e5a2c045ac0260f9d6c7cf3&amp;type=3#Perpetua-Titling-Regular&quot;);"/>
